rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Projects collection
    match /projects/{projectId} {
      // Anyone can read with project ID for client dashboards & join pages
      allow read: if true;

      // Authenticated users can create orders
      allow create: if isSignedIn();

      // Updates: Admin can update anything. Owner can update setup data if not yet completed.
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.customer_id == request.auth.uid
      );

      allow delete: if isAdmin();
    }

    // 3. Project Members collection
    match /project_members/{memberId} {
      allow read: if true;
      allow create: if isSignedIn() || isAdmin();
      allow update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    // 4. Member Secrets collection (STRICT SERVER-ONLY)
    // NEVER allow client SDK read or write! Only Firebase Admin SDK on server.
    match /member_secrets/{memberId} {
      allow read, write: if false;
    }

    // 5. Commit Schedules collection
    match /commit_schedules/{scheduleId} {
      allow read: if true;
      // Schedules can only be modified by Admin or Server Cron
      allow create, update, delete: if isAdmin();
    }
  }
}
